# Copier en `.env` puis ajuster. Toutes les variables sont optionnelles (valeurs par défaut indiquées).

# Site cible — changez cette valeur pour scraper un autre site.
# NB : ww1.lat/cpasbien/ n'est qu'une passerelle qui redirige vers www.cpasbien.fyi.
# Vous pouvez cibler directement le vrai site :
#   SCRAPER_BASE_URL=https://www.cpasbien.fyi/
SCRAPER_BASE_URL=https://ww1.lat/cpasbien/

# Page de la liste complète des films (chemin relatif au domaine courant, résolu
# après les redirections). Sur cpasbien = lien « Voir tous les Films ».
SCRAPER_LIST_PATH=/category/films

# Domaines « maison » supplémentaires à autoriser (séparés par des virgules), en plus
# du domaine de SCRAPER_BASE_URL. OPTIONNEL : le scraper apprend automatiquement les
# domaines par lesquels le site redirige (ww1.lat -> cpasbien.fyi -> cpasbien*.cc) ;
# ne renseignez ceci que pour forcer une autorisation supplémentaire.
SCRAPER_ALLOWED_DOMAINS=

# Mode navigateur : false = fenêtre visible (utile pour Cloudflare/debug), true = sans interface.
SCRAPER_HEADLESS=false

# Nombre maximum de films à analyser dans la liste.
SCRAPER_MAX_FILMS=100

# Années recherchées dans le titre (séparées par des virgules).
SCRAPER_YEARS=2025,2026

# Taille maximale (en Go, strictement inférieure) pour déclencher le téléchargement.
SCRAPER_MAX_SIZE_GB=5

# Dossier de sortie des fichiers .torrent.
SCRAPER_OUTPUT_DIR=downloads

# Délai de navigation max (ms) et pause de politesse entre deux films (ms).
SCRAPER_NAV_TIMEOUT_MS=45000
SCRAPER_REQUEST_DELAY_MS=1000
